{
  "name": "Yungame",
  "productName": "YunGame",
  "version": "0.1.0",
  "description": "游戏库管理器（Electron + TypeScript 移植版）",
  "main": "dist-electron/electron/main.js",
  "author": "",
  "scripts": {
    "dev": "node scripts/library-json.mjs sync && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:arch": "node scripts/check-architecture.mjs",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:docs": "node scripts/check-docs.mjs",
    "lint:fonts": "node scripts/audit-font-sizes.mjs",
    "themes:gen": "node scripts/gen-static-themes.mjs --apply",
    "themes:audit": "node scripts/gen-static-themes.mjs --audit",
    "check": "npm run typecheck && npm run test && npm run lint:arch && npm run lint:i18n && npm run lint:docs && npm run lint:fonts",
    "db:export": "node scripts/library-json.mjs export",
    "db:import": "node scripts/library-json.mjs import",
    "db:find": "node scripts/library-json.mjs find",
    "db:backup": "node scripts/library-json.mjs backup",
    "build": "node scripts/build.mjs",
    "build:full": "tsc -p tsconfig.main.json && tsc -p tsconfig.json --noEmit && vite build",
    "pack": "node scripts/pack.mjs",
    "pack:full": "node scripts/pack.mjs --full",
    "start": "electron .",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "i18next": "^23.15.0",
    "lucide-react": "^1.31.0",
    "nodemailer": "^9.0.5",
    "pinyin-pro": "^3.29.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^6.30.0",
    "sonner": "^2.0.8",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.24.0",
    "@rollup/rollup-win32-x64-msvc": "^4.62.4",
    "@splidejs/splide": "^4.1.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "chroma-js": "^3.2.0",
    "concurrently": "^9.0.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "photoswipe": "^5.4.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.0"
  }
}
