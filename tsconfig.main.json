{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // 增量编译：dev-client.bat 每次启动都会先编译主进程（见该脚本注释），
    // 增量能把重复编译从 ~6 秒降到 ~1 秒。产物放 dist-electron（已在 .gitignore）。
    "incremental": true,
    "tsBuildInfoFile": "dist-electron/.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // shared 显式列入：tsc 只会编译"从 include 出发能被 import 到"的文件，而
  // shared/releaseConfig.ts 的消费者是 scripts/prepare-release.mjs（出包脚本，
  // 跑纯 node、读 dist-electron 里的编译产物）—— 不被 electron/ 引用就永远不会被产出。
  "include": ["electron", "shared", "build.config.ts"],
  // 测试文件由 vitest 跑、由 tsconfig.json（含 shared/src 的测试）做类型检查，
  // 不要编进 dist-electron —— 否则发布产物里会多出 __tests__ 目录。
  "exclude": ["node_modules", "dist-electron", "**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
